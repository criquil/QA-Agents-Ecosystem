{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "automation-qa-orchestrator",
  "references": {
    "skills": {
      "path": ".opencode/skills",
      "description": "Indice maestro de las 10 skills de Automation QA"
    },
    "knowledge": {
      "path": "docs/knowledge/Automation_QA",
      "description": "Conocimiento de automatizacion: fundamentos, frameworks, POM, selectores, datos, tags, CI/CD"
    },
    "templates": {
      "path": "docs/templates",
      "description": "Templates oficiales de casos de prueba"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "env": {}
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "env": {}
    }
  },
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "task": "allow",
    "edit": "allow",
    "write": "allow",
    "lsp": "allow",
    "bash": {
      "python *": "allow",
      "pip *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "npm *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "*": "ask"
    }
  },
  "logLevel": "INFO",
  "share": "manual"
}